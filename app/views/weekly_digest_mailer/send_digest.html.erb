<p>Hi <%= @user.email %>,</p>

<% if @articles.any? %>
  <p>Here's what you saved since <%= @since.to_date %>:</p>
  <ul>
    <% @articles.each do |article| %>
      <li><%= link_to article.title, article.url %></li>
    <% end %>
  </ul>
<% else %>
  <p>You didn't save anything this week. Nothing to catch up on — nice.</p>
<% end %>

<p>— Readlater</p>
